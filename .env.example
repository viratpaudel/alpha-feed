# API
PORT=4000
VITE_API_URL=http://localhost:4000/api
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/alpha_feed

# Wallet Authentication
WALLET_AUTH_ENABLED=true
SIWE_DOMAIN=localhost:3000

# Kuru Exchange API (Real Market Data)
KURU_API_KEY=your_kuru_api_key
KURU_WS_URL=wss://api.kuru.io/v1/ws
KURU_REST_URL=https://api.kuru.io/v1

# Hunyuan AI (Chart Analysis)
HUNYUAN_API_KEY=your_hunyuan_api_key
HUNYUAN_API_URL=https://api.hunyuan.cloud/v1

# Optional: CoinGecko for token prices
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# JWT Session
JWT_SECRET=your_super_secret_jwt_key_change_in_prod
JWT_EXPIRES_IN=7d
